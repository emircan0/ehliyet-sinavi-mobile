{
  "expo": {
    "name": "Ehliyet Hocam",
    "slug": "ehliyet-hocam",
    "version": "1.2.4",
    "orientation": "portrait",
    "icon": "./assets/images/logo.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "ehliyet-sinavi",
    "splash": {
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ehliyet.ai.sinav",
      "usesAppleSignIn": true,
      "buildNumber": "2",
      "infoPlist": {
        "CFBundleDisplayName": "Ehliyet Hocam",
        "NSCameraUsageDescription": "Uygulama, profil fotoğrafınızı güncellemek için kameraya erişim gerektirir.",
        "NSPhotoLibraryUsageDescription": "Uygulama, profil fotoğrafınızı seçmek için fotoğraf galerinize erişim gerektirir.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.ehliyet.ai.sinav",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.247538031791-tl9ub933k1qp5q351ls1c3ubcru7uufe"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-4597159043915160~9655088226"
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "546ff7a6-3ab4-4d6f-9ae2-b75816db2856"
      }
    },
    "owner": "emircanmert"
  }
}
