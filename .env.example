# Supabase Configuration
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Local-only import/admin scripts. Never expose this in the mobile app.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# RevenueCat Configuration (In-app Purchases)
EXPO_PUBLIC_REVENUECAT_APPLE_KEY=your_apple_api_key
EXPO_PUBLIC_REVENUECAT_GOOGLE_KEY=your_android_api_key

# Google Sign-In Configuration
# (iOS URL Scheme is configured in app.json automatically)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id

# EAS Configuration
# (This should be obtained from 'npx eas init' command)
# EXPO_PUBLIC_EAS_PROJECT_ID=your_eas_project_id
